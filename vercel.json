{
  "version": 2,
  "builds": [
    {
      "src": "PulseFloor/index.ts", // Path from repo root to your main server file
      "use": "@vercel/node",
      "config": {
        // Make sure your UI assets and other necessary files are included
        "includeFiles": ["PulseFloor/assets/**", "PulseFloor/audio/**"] 
      }
    }
  ],
  "routes": [
    // Route all incoming requests to be handled by your index.ts server
    {
      "src": "/(.*)",
      "dest": "PulseFloor/index.ts"
    }
  ]
} 